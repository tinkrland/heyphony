{
  "name": "heyphony",
  "version": "0.3.0",
  "description": "give your ai agent a phone number of its own: a sip did, an inbox that survives the machine sleeping, and the rails a number unlocks",
  "keywords": [
    "ai-agent",
    "cli",
    "did",
    "mcp",
    "model-context-protocol",
    "sip",
    "sms",
    "telephony",
    "voip"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "tinkrland (https://github.com/tinkrland)",
  "bin": {
    "heyphony": "bin/heyphony.js",
    "heyphony-mcp": "bin/heyphony-mcp.js"
  },
  "files": [
    "bin/",
    "lib/",
    "index.js",
    "python/",
    "readme.md",
    "agents.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bundle": "node scripts/bundle.js",
    "prepack": "node scripts/bundle.js --strict",
    "postpack": "node scripts/bundle.js --clean",
    "prepublishOnly": "npm test",
    "preflight": "node scripts/preflight.js",
    "test": "node scripts/bundle.js --strict && node bin/heyphony.js --version && node scripts/test-mcp.js && node scripts/bundle.js --clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinkrland/heyphony.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/tinkrland/heyphony/tree/main/npm",
  "bugs": {
    "url": "https://github.com/tinkrland/heyphony/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./mcp": "./bin/heyphony-mcp.js"
  }
}
