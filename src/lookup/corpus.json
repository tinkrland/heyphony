      "number": "+442071234567",
      "expect": {
        "market": "GB",
        "type": "landline",
        "receive_text": false,
        "region": "london"
      },
      "why": "ofcom geographic range"
    },
    {
      "id": "gb-mobile-contrast",
      "number": "+447700900123",
      "expect": {
        "market": "GB",
        "type": "mobile",
        "receive_text": true
      },
      "contrast": "gb-landline-london",
      "why": "the same country, the opposite answer"
    },
    {
