#!/bin/sh
# heyphony, from a clone. this is the shim the repo ships and the one install.sh links into.
#
# it resolves symlinks because that is the install shape: ~/.local/bin/heyphony points here, and a
# shim that trusts $0 would then look for the package in ~/.local instead of in the clone.
set -eu

self="$0"
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self="$target" ;;
    *) self="$(cd "$(dirname "$self")" && pwd)/$target" ;;
  esac
done
here=$(cd "$(dirname "$self")/.." && pwd)

# the code is the repo root, so the import root is $here and the module is src.runner.cli. no bytecode
# is written: this tree has no .gitignore, so an import that leaves __pycache__ behind is a dirty tree.
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" PYTHONDONTWRITEBYTECODE=1 \
  exec "${HEYPHONY_PYTHON:-python3}" -m src.runner.cli "$@"
